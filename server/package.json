{
  "name": "bhabhi-thulla-server",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/src/db/schema.sql",
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
